<?xml version="1.0" encoding="UTF-8"?>
<Pathway xmlns="http://pathvisio.org/GPML/2013a" Name="NRF2 signalling in colorectal cancer malignant progression (baseline map)" Data-Source="Literature-derived, PubMed" Version="20261029" Organism="Homo sapiens">
  <Comment Source="WikiPathways-description">Baseline, evidence-tracked map of NRF2 (NFE2L2) regulation and its downstream effectors in human colorectal cancer. Solid edges = main pathway (species/disease/cell match C1-C2 and evidence level E1-E3). Broken edges = candidate pathway (other systems, or association only). mRNA nodes are gene-product-level functional summaries, not claims that transcription is the dominant mechanism. No drug intervention layer is included. Node and edge GraphIds correspond to the Entities and Reactions sheets of the companion Excel file.</Comment>
  <Graphics BoardWidth="1280.0" BoardHeight="1340.0" />
  <DataNode TextLabel="MYC" GraphId="N001" Type="Protein">
    <Comment>c-MYC. Upstream modulator of NRF2 in CRC cells.</Comment>
    <Graphics CenterX="150.0" CenterY="165.0" Width="150.0" Height="28.0" ZOrder="32768" FontSize="10" Valign="Middle" FillColor="ffffff" />
    <Xref Database="Entrez Gene" ID="4609" />
  </DataNode>
